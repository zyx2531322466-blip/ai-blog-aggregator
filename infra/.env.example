# 容器编排环境变量示例：cp infra/.env.example infra/.env

# PostgreSQL
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog

# 后端运行环境（development / production / test）
APP_ENVIRONMENT=development

# 维护者令牌：必须替换为强随机值（示例占位值，切勿在公开仓库填写真实令牌）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ADMIN_TOKEN=change-me-in-production

# 爬虫 User-Agent：建议替换为可联系到你的标识
APP_CRAWLER_USER_AGENT=BlogAggregatorBot/0.1 (+https://example.com/bot)

# 依赖安装使用的镜像源（受限网络下可覆盖）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
