# 容器编排环境变量示例：cp infra/.env.example infra/.env

# PostgreSQL
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog

# 后端运行环境（development / production / test）
APP_ENVIRONMENT=development

# 维护者令牌：必须替换为强随机值（示例占位值，切勿在公开仓库填写真实令牌）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ADMIN_TOKEN=change-me-in-production

# 爬虫 User-Agent：建议替换为可联系到你的标识
APP_CRAWLER_USER_AGENT=BlogAggregatorBot/0.1 (+https://example.com/bot)

# 依赖安装使用的镜像源（受限网络下可覆盖）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------------------------------------------------------------------------
# v2：订阅与邮件推送（T22–T24）
# ---------------------------------------------------------------------------
# 对外可达地址：用于生成确认/退订链接（订阅者必须能打开）
APP_PUBLIC_BASE_URL=http://localhost:3000
# 真实发信开关：默认关闭（只记录不投递）；确认可用后再置为 true
APP_MAIL_ENABLED=false
# SMTP：生产请填写真实邮件服务；本地可用 Mailpit/MailHog（默认 1025）
APP_SMTP_HOST=localhost
APP_SMTP_PORT=1025
APP_SMTP_USER=
APP_SMTP_PASSWORD=
APP_SMTP_USE_TLS=false
# 发件人：需与发信域名的 SPF/DKIM/DMARC 配置一致，否则易进垃圾箱
APP_MAIL_FROM=no-reply@example.com
# 推送节奏与限制
APP_DIGEST_DEFAULT_FREQUENCY=weekly
APP_DIGEST_MAX_ITEMS=10
APP_DIGEST_SEND_WINDOW_START_HOUR=9
APP_DIGEST_SEND_WINDOW_END_HOUR=21
APP_DIGEST_SEND_EMPTY=false
APP_DIGEST_MAX_RETRIES=3
# 失败率超过该比例时自动暂停推送
APP_BOUNCE_PAUSE_THRESHOLD=0.05

# ---------------------------------------------------------------------------
# v2：LLM Wiki 知识级去重（T25–T26）
# ---------------------------------------------------------------------------
# 外部 LLM（OpenAI 兼容接口，可指向自建网关）；留空则知识去重不可用
APP_LLM_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=gpt-4o-mini
APP_LLM_TIMEOUT_SECONDS=30
APP_LLM_MAX_CALLS_PER_RUN=200
# 知识级去重默认关闭：先观察文本级去重与分类效果，再逐步开启
APP_KNOWLEDGE_ENABLED=false
# 保守阈值：达到 high 才判"已覆盖"；中间区间交模型二次判定
APP_KNOWLEDGE_SIMILARITY_HIGH=0.92
APP_KNOWLEDGE_SIMILARITY_LOW=0.80
APP_KNOWLEDGE_PROMPT_VERSION=knowledge-v1
